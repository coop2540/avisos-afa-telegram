# Copia aquest fitxer a `.env` i omple els valors reals.
# `.env` està ignorat per git: els secrets no es versionen mai.

# Token del bot de Telegram (BotFather). OBLIGATORI per publicar.
TELEGRAM_BOT_TOKEN=

# Opcional: sobreescriu el chat_id de config.yaml
# TELEGRAM_CHAT_ID=-1000000000000

# Mode de proves: si val "1"/"true", no envia res a Telegram, només ho registra.
# DRY_RUN=0

# Rutes opcionals
# CONFIG_PATH=config.yaml
# STATE_PATH=state/state.json

# Nivell de log: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# UID/GID amb què s'executa el contenedor (perquè state/ no quedi com a root).
# PUID=1000
# PGID=1000
