# Configuració del servei d'avisos AFA — exemple (desplegament de referència:
# Escola Elisa Badia). Copia a `config.yaml` i ajusta per al teu centre.
# No conté secrets (aquests van a `.env`).

# Idioma dels missatges del servei (catàlegs a `src/i18n/`).
# Per defecte: ca. Altres: es, en. Afegir-ne un = afegir un fitxer JSON.
language: ca

# Zona horària per a la planificació (agenda setmanal).
timezone: Europe/Madrid

site:
  base_url: "https://agora.xtec.cat/escolaelisabadia"
  homepage: "https://agora.xtec.cat/escolaelisabadia/"
  feed: "https://agora.xtec.cat/escolaelisabadia/feed/"
  calendari_page: "https://agora.xtec.cat/escolaelisabadia/lescola/calendari-del-curs/"
  user_agent: "avisos-afa-telegram/0.1 (servei d'avisos AFA; contacte: AFA)"

rss:
  # Categories del blog que es publiquen (comparació sense distingir majúscules).
  # Fase A: curs objectiu (I4) + genèriques del centre.
  include_categories:
    - "I4"
    - "Portada"
    - "General"
  # Límit d'elements publicats per cicle per no fer un esclat si n'hi ha molts.
  max_items_per_cycle: 10

carta:
  # Fragments de text de l'enllaç a la portada que identifiquen la carta del mes.
  link_text_markers:
    - "carta del mes"
    - "consulteu la carta"
  # Alternativa: si cap text coincideix, accepta un href que contingui això i acabi en .pdf
  fallback_href_contains:
    - "carta-mes"
    - "carta-mes-"

poll:
  # Sondeig adaptatiu (minuts)
  base_minutes: 60          # interval normal
  hot_minutes: 20           # després de detectar novetat
  hot_window_minutes: 180   # durant quant de temps es manté "calent"
  calm_minutes: 240         # quan fa dies que no hi ha res (4h)
  quiet_after_days: 7       # dies sense novetat per passar a mode calma

telegram:
  # Identificador del grup/canal de destí (NO és secret).
  chat_id: null
  # Xat privat de l'administrador: rep els avisos de sol·licituds d'unió.
  admin_chat_id: null
  # Aprovació de membres (semi-automàtica).
  approval:
    enabled: false
    receive: polling        # polling | webhook
    webhook:
      url: null             # només si receive=webhook (cal HTTPS públic)
      # El secret del webhook es posa a .env: TELEGRAM_WEBHOOK_SECRET
    auto_reject:            # opt-in; NOMÉS pot rebutjar, mai aprovar sol
      enabled: false
      block_empty_name: true
      block_spam_bio: true
  # Topics (message_thread_id) per origen. null = topic general / sense topic.
  topics:
    default: null
    rss: null
    carta: null
    calendari: null
    agenda: null

first_run:
  # Si false (recomanat), la primera execució només desa la línia base sense
  # publicar l'històric. Si true, publica un únic avís de benvinguda.
  publish_welcome: false

agenda:
  # Agenda extreta de la taula d'activitats de la carta (Dia | Curs | Activitat).
  enabled: true
  # Cursos que t'interessen (i etiquetes compartides). "I4" inclou "I4B".
  cursos: ["I4", "Tothom", "Famílies"]
  # En detectar carta nova, publicar la selecció d'activitats del curs (a més de l'enllaç).
  carta_filtrada: true
  setmanal:
    # Publicar l'agenda de la setmana un dia i hora concrets.
    enabled: true
    dia: 1        # 1=dilluns … 7=diumenge
    hora: "08:00"
